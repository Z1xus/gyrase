import "../assets/fonts/Geist-Regular.ttf";
import "../assets/fonts/Geist-Medium.ttf";
import "../assets/fonts/Geist-SemiBold.ttf";
import { Gel, Metrics } from "palette.slint";
import { DoneView } from "done-view.slint";
import { PickView } from "pick-view.slint";
import { ReadyView } from "ready-view.slint";
import { RunningView } from "running-view.slint";
import { Chip, Step, StepKind, View, Written } from "types.slint";

export { Chip, Step, StepKind, View, Written }

export component App inherits Window {
    in property <View> view: View.pick;
    in property <bool> dragging;
    in property <string> error;
    in property <string> name;
    in property <string> detail;
    in property <[Step]> steps;
    in property <[Chip]> chips;
    in property <string> folder;
    in property <int> current;
    in property <float> progress;
    in property <string> percent;
    in property <string> eta;
    in property <[Written]> written;
    callback choose-file;
    callback remove-sample;
    callback toggle-format(int);
    callback choose-folder;
    callback start;
    callback cancel;
    callback open-folder;
    callback another-file;

    title: "gyrase";
    icon: @image-url("../assets/gyrase.svg");
    background: Gel.canvas;
    default-font-family: "Geist";
    default-font-weight: 400;
    min-width: 440px;
    max-width: 440px;
    min-height: 560px;
    max-height: 560px;

    VerticalLayout {
        padding: Metrics.page;

        if root.view == View.pick: PickView {
            dragging: root.dragging;
            error: root.error;
            choose => {
                root.choose-file();
            }
        }

        if root.view == View.ready: ReadyView {
            name: root.name;
            detail: root.detail;
            chips: root.chips;
            folder: root.folder;
            error: root.error;
            remove => {
                root.remove-sample();
            }
            toggle(index) => {
                root.toggle-format(index);
            }
            choose-folder => {
                root.choose-folder();
            }
            start => {
                root.start();
            }
        }

        if root.view == View.running || root.view == View.stopping: RunningView {
            name: root.name;
            detail: root.detail;
            steps: root.steps;
            current: root.current;
            progress: root.progress;
            percent: root.percent;
            eta: root.eta;
            cancellable: root.view == View.running;
            cancel => {
                root.cancel();
            }
        }

        if root.view == View.done: DoneView {
            written: root.written;
            error: root.error;
            open-folder => {
                root.open-folder();
            }
            again => {
                root.another-file();
            }
        }
    }
}
