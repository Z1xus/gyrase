import { Gel } from "palette.slint";
import { StepKind } from "types.slint";

export global Icons {
    out property <image> align: @image-url("../assets/icons/text-align-start.svg");
    out property <image> check: @image-url("../assets/icons/check.svg");
    out property <image> close: @image-url("../assets/icons/x.svg");
    out property <image> dna: @image-url("../assets/icons/dna.svg");
    out property <image> done: @image-url("../assets/icons/circle-check.svg");
    out property <image> download: @image-url("../assets/icons/download.svg");
    out property <image> error: @image-url("../assets/icons/circle-x.svg");
    out property <image> export: @image-url("../assets/icons/file-down.svg");
    out property <image> file: @image-url("../assets/icons/file-text.svg");
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> index: @image-url("../assets/icons/list-ordered.svg");
    out property <image> minimize: @image-url("../assets/icons/minus.svg");
    out property <image> new-file: @image-url("../assets/icons/file-plus.svg");
    out property <image> sort: @image-url("../assets/icons/arrow-down-up.svg");

    public pure function step(kind: StepKind) -> image {
        if kind == StepKind.reference {
            return Icons.download;
        }
        if kind == StepKind.index {
            return Icons.index;
        }
        if kind == StepKind.align {
            return Icons.align;
        }
        if kind == StepKind.sort {
            return Icons.sort;
        }
        if kind == StepKind.call {
            return Icons.dna;
        }
        return Icons.export;
    }
}

export component Icon inherits Image {
    in property <color> tint: Gel.ink-muted;
    in property <length> size: 16px;

    width: root.size;
    height: root.size;
    image-fit: contain;
    colorize: root.tint;
}
