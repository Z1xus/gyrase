import { Gel } from "palette.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton } from "controls.slint";

export component TitleBar inherits Rectangle {
    callback drag(Point);
    callback minimize;
    callback close;

    height: 44px;

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag({
                    x: self.absolute-position.x + self.mouse-x,
                    y: self.absolute-position.y + self.mouse-y,
                });
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        spacing: 8px;
        alignment: start;

        Icon {
            source: Icons.dna;
            tint: Gel.accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: "gyrase";
            font-size: 13px;
            font-weight: 600;
            color: Gel.ink;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        padding-right: 8px;
        spacing: 4px;
        alignment: end;

        IconButton {
            source: Icons.minimize;
            label: "Minimize";
            y: (parent.height - self.height) / 2;
            clicked => {
                root.minimize();
            }
        }

        IconButton {
            source: Icons.close;
            label: "Close";
            y: (parent.height - self.height) / 2;
            clicked => {
                root.close();
            }
        }
    }
}
