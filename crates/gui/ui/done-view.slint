import { Gel, Metrics } from "palette.slint";
import { Icon, Icons } from "icons.slint";
import { Card, ErrorLine, PrimaryButton, SecondaryButton, Section } from "controls.slint";
import { Written } from "types.slint";

export component DoneView inherits VerticalLayout {
    in property <[Written]> written;
    in property <string> error;
    callback open-folder;
    callback again;

    spacing: Metrics.section;

    VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        spacing: Metrics.pad;

        HorizontalLayout {
            alignment: center;

            Icon {
                source: Icons.done;
                size: 64px;
                tint: Gel.accent;
            }
        }

        Text {
            text: "Your files are ready";
            font-size: 20px;
            font-weight: 600;
            color: Gel.ink;
            horizontal-alignment: center;
        }
    }

    Section {
        title: "Files";

        Card {
            VerticalLayout {
                padding: Metrics.pad;
                padding-top: 10px;
                padding-bottom: 10px;

                for entry in root.written: HorizontalLayout {
                    height: Metrics.row + 4px;
                    spacing: 12px;

                    Icon {
                        source: entry.raw ? Icons.file : Icons.dna;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: entry.name;
                        horizontal-stretch: 1;
                        font-size: 13px;
                        color: Gel.ink;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    Text {
                        text: entry.detail;
                        font-size: 12px;
                        color: Gel.ink-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: Metrics.pad;

        if root.error != "": ErrorLine {
            text: root.error;
        }

        HorizontalLayout {
            spacing: Metrics.gap;

            SecondaryButton {
                horizontal-stretch: 1;
                text: "Another File";
                clicked => {
                    root.again();
                }
            }

            PrimaryButton {
                horizontal-stretch: 1;
                text: "Open Folder";
                clicked => {
                    root.open-folder();
                }
            }
        }
    }
}
