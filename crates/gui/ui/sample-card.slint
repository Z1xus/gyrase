import { Gel, Metrics } from "palette.slint";
import { Icon, Icons } from "icons.slint";
import { Card, IconButton } from "controls.slint";

export component Tile inherits Rectangle {
    in property <image> source;
    in property <length> size: 40px;

    width: root.size;
    height: root.size;
    border-radius: root.size * 0.3;
    background: Gel.accent-wash;

    Icon {
        source: root.source;
        size: root.size * 0.5;
        tint: Gel.accent-ink;
    }
}

export component SampleCard inherits Card {
    in property <string> name;
    in property <string> detail;
    in property <bool> removable;
    callback remove;

    height: 72px;

    HorizontalLayout {
        padding: Metrics.pad;
        padding-right: root.removable ? 12px : Metrics.pad;
        spacing: 12px;

        Tile {
            source: Icons.dna;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.name;
                font-size: 15px;
                font-weight: 600;
                color: Gel.ink;
                overflow: elide;
            }

            Text {
                text: root.detail;
                font-size: 12px;
                color: Gel.ink-muted;
                overflow: elide;
            }
        }

        if root.removable: IconButton {
            source: Icons.close;
            label: "Remove";
            y: (parent.height - self.height) / 2;
            clicked => {
                root.remove();
            }
        }
    }
}
