import { Gel } from "palette.slint";
import { Icon, Icons } from "icons.slint";
import { Card, IconButton, Tag } from "controls.slint";

export component Tile inherits Rectangle {
    in property <image> source;
    in property <length> size: 40px;

    width: root.size;
    height: root.size;
    border-radius: root.size * 0.3;
    background: @linear-gradient(180deg, Gel.accent-wash.brighter(0.1) 0%, Gel.accent-wash 100%);
    border-width: 1px;
    border-color: Gel.accent-wash.darker(0.05);

    Icon {
        source: root.source;
        size: root.size * 0.5;
        tint: Gel.accent-ink;
    }
}

export component SampleCard inherits Card {
    in property <string> name;
    in property <[string]> tags;
    in property <bool> removable;
    callback remove;

    height: 76px;

    HorizontalLayout {
        padding: 16px;
        padding-right: root.removable ? 12px : 16px;
        spacing: 12px;

        Tile {
            source: Icons.dna;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;

            Text {
                text: root.name;
                font-size: 15px;
                font-weight: 600;
                color: Gel.ink;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                for tag in root.tags: Tag {
                    text: tag;
                }
            }
        }

        if root.removable: IconButton {
            source: Icons.close;
            label: "Remove";
            y: (parent.height - self.height) / 2;
            clicked => {
                root.remove();
            }
        }
    }
}
