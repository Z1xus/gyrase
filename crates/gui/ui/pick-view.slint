import { Gel, Metrics } from "palette.slint";
import { Icons } from "icons.slint";
import { ErrorLine, PrimaryButton } from "controls.slint";
import { Tile } from "sample-card.slint";

export component PickView inherits VerticalLayout {
    in property <bool> dragging;
    in property <string> error;
    in property <string> version;
    callback choose;

    spacing: Metrics.section;

    Rectangle {
        vertical-stretch: 1;
        border-radius: Metrics.radius;
        border-width: 1px;
        border-color: root.dragging ? Gel.accent : Gel.line;
        background: root.dragging ? Gel.accent-wash : Gel.surface;

        VerticalLayout {
            alignment: center;
            spacing: Metrics.gap;

            HorizontalLayout {
                alignment: center;
                padding-bottom: Metrics.gap;

                Tile {
                    source: Icons.new-file;
                    size: 64px;
                }
            }

            Text {
                text: root.dragging ? "Release to add" : "Drop your files here";
                font-size: 20px;
                font-weight: 700;
                color: Gel.ink;
                horizontal-alignment: center;
            }

            Text {
                text: "FASTQ, SAM, BAM, CRAM or VCF";
                font-size: 13px;
                color: Gel.ink-muted;
                horizontal-alignment: center;
            }
        }

        Text {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - Metrics.pad;
            text: root.version;
            font-size: 11px;
            color: Gel.ink-muted;
        }
    }

    VerticalLayout {
        spacing: Metrics.pad;

        if root.error != "": ErrorLine {
            text: root.error;
        }

        PrimaryButton {
            text: "Choose Files";
            clicked => {
                root.choose();
            }
        }
    }
}
