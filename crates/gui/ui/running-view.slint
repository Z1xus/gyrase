import { Gel, Metrics } from "palette.slint";
import { Icon, Icons } from "icons.slint";
import { Card, ProgressBar, SecondaryButton, Section } from "controls.slint";
import { SampleCard } from "sample-card.slint";
import { Step } from "types.slint";

export component RunningView inherits VerticalLayout {
    in property <string> name;
    in property <string> detail;
    in property <[Step]> steps;
    in property <int> current;
    in property <float> progress;
    in property <string> status;
    in property <bool> cancellable;
    callback cancel;

    spacing: Metrics.section;

    SampleCard {
        name: root.name;
        detail: root.detail;
    }

    Section {
        title: "Progress";

        Card {
            VerticalLayout {
                padding: Metrics.pad;
                padding-top: 10px;
                padding-bottom: 10px;

                for step[index] in root.steps: HorizontalLayout {
                    height: Metrics.row;
                    spacing: 12px;

                    Icon {
                        source: Icons.step(step.kind);
                        tint: index <= root.current ? Gel.accent : Gel.ink-muted;
                        opacity: index > root.current ? 0.5 : 1;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: step.label;
                        horizontal-stretch: 1;
                        font-size: 13px;
                        font-weight: index == root.current ? 600 : 400;
                        color: index == root.current ? Gel.ink : Gel.ink-muted;
                        opacity: index > root.current ? 0.5 : 1;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    padding-top: 12px;
                    spacing: Metrics.gap;

                    ProgressBar {
                        value: root.progress;
                    }

                    Text {
                        text: root.status;
                        font-size: 12px;
                        color: Gel.ink-muted;
                        min-height: 16px;
                    }
                }
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 1;
        alignment: end;

        if root.cancellable: SecondaryButton {
            text: "Cancel";
            clicked => {
                root.cancel();
            }
        }
    }
}
