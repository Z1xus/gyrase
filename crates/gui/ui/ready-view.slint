import { Gel, Metrics } from "palette.slint";
import { Icon, Icons } from "icons.slint";
import { Card, ErrorLine, Pressable, PrimaryButton, Section, Toggle } from "controls.slint";
import { SampleCard } from "sample-card.slint";
import { Chip } from "types.slint";

component FolderRow inherits Card {
    in property <string> path;
    callback choose;

    height: Metrics.control + 8px;

    HorizontalLayout {
        padding-left: Metrics.pad;
        padding-right: Metrics.pad;
        spacing: 12px;

        Icon {
            source: Icons.folder;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.path;
            horizontal-stretch: 1;
            font-size: 13px;
            color: Gel.ink;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            text: "Change";
            font-size: 13px;
            font-weight: 600;
            color: Gel.accent-ink;
            vertical-alignment: center;
        }
    }

    Pressable {
        accessible-label: "Change Folder";
        clicked => {
            root.choose();
        }
    }
}

export component ReadyView inherits VerticalLayout {
    in property <string> name;
    in property <string> detail;
    in property <[Chip]> chips;
    in property <string> folder;
    in property <string> error;
    callback remove;
    callback toggle(int);
    callback choose-folder;
    callback start;

    spacing: Metrics.section;

    SampleCard {
        name: root.name;
        detail: root.detail;
        removable: true;
        remove => {
            root.remove();
        }
    }

    if root.chips.length > 0: Section {
        title: "Raw data formats";

        GridLayout {
            spacing: Metrics.gap;

            for chip[index] in root.chips: Toggle {
                row: index < 3 ? 0 : 1;
                col: index < 3 ? index * 2 : (index - 3) * 3;
                colspan: index < 3 ? 2 : 3;
                text: chip.label;
                on: chip.on;
                clicked => {
                    root.toggle(index);
                }
            }
        }
    }

    Section {
        title: "Save to";

        FolderRow {
            path: root.folder;
            choose => {
                root.choose-folder();
            }
        }
    }

    VerticalLayout {
        vertical-stretch: 1;
        alignment: end;
        spacing: Metrics.pad;

        if root.error != "": ErrorLine {
            text: root.error;
        }

        PrimaryButton {
            text: "Start";
            clicked => {
                root.start();
            }
        }
    }
}
